# =============================================================================
# AccessibleWebsite / Barrierefreiewebseite — environment variables
# Copy to .env, fill in real values, chmod 600.
# =============================================================================

# --- Database (dedicated Postgres on VPS port 5433) -------------------------
DATABASE_URL=postgres://accessiblewebsite:CHANGEME@127.0.0.1:5433/accessiblewebsite
POSTGRES_PASSWORD=CHANGEME

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380

# --- App URLs (used for canonical, hreflang, email links) -------------------
PUBLIC_SITE_URL_EN=https://accessiblewebsite.net
PUBLIC_SITE_URL_DE=https://barrierefreiewebseite.net

# --- Session + seal signing -------------------------------------------------
SESSION_SECRET=CHANGEME_use_openssl_rand_base64_32
SEAL_JWT_SECRET=CHANGEME_use_openssl_rand_base64_32

# --- OAuth ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe (subscriptions) -------------------------------------------------
# Operator setup, in order:
#   1. Create a Stripe account, switch to TEST mode for the first run.
#   2. Stripe Dashboard → Products: create two recurring products:
#        - "Gold"     — monthly €9   + yearly €90  (EUR)
#        - "Gold Pro" — monthly €19  + yearly €190 (EUR)
#      You get 4 Price IDs (price_xxx). Copy them below.
#   3. Stripe Dashboard → Developers → API keys: copy the *secret* key (sk_...).
#   4. Stripe Dashboard → Developers → Webhooks → "Add endpoint":
#        URL:    https://accessiblewebsite.net/api/v1/webhooks/stripe
#        Events: checkout.session.completed
#                customer.subscription.created
#                customer.subscription.updated
#                customer.subscription.deleted
#                invoice.payment_succeeded
#                invoice.payment_failed
#      Copy the *signing secret* (whsec_...) into STRIPE_WEBHOOK_SECRET.
#   5. Stripe Dashboard → Settings → Customer portal: enable it, allow cancel,
#      update payment method, and switch between Gold ↔ Gold Pro / month ↔ year.
#   6. Stripe Dashboard → Settings → Tax: enable Stripe Tax for automatic EU VAT.
#   7. Restart the web process (pm2 restart accessiblewebsite-web) and place a
#      test purchase using card 4242 4242 4242 4242 to verify end-to-end.
# Leaving ALL these blank disables billing cleanly — checkout/portal endpoints
# return a friendly "billing not configured" redirect instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
STRIPE_PRICE_GOLD_PRO_MONTHLY=
STRIPE_PRICE_GOLD_PRO_YEARLY=

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EN=team@accessiblewebsite.net
RESEND_FROM_DE=team@barrierefreiewebseite.net

# --- S3-compatible object storage (PDF reports, seal SVGs) -----------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=accessiblewebsite-reports
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Monitoring -------------------------------------------------------------
SENTRY_DSN=
PLAUSIBLE_DOMAIN_EN=accessiblewebsite.net
PLAUSIBLE_DOMAIN_DE=barrierefreiewebseite.net

# --- Cal.com (consultation booking) ----------------------------------------
CALCOM_URL_EN=
CALCOM_URL_DE=

# --- Scanner rate limits & caps --------------------------------------------
SCAN_RATE_ANONYMOUS_PER_HOUR=3
SCAN_RATE_FREE_PER_DAY=10
SCAN_GOLD_MAX_PAGES=250
SCAN_GOLD_PRO_MAX_PAGES=2500

# Set to a real secret string to enable the ?unlimitedcy=<token> URL bypass
# of the anonymous scan rate limit. Anyone with this value can spam the
# scanner — treat it like a password, rotate it before going public.
# Leave EMPTY to disable the bypass entirely.
RATELIMIT_BYPASS_TOKEN=

# Comma-separated list of operator emails. These accounts:
#   - are treated as Enterprise tier (no Stripe subscription required)
#   - skip the anonymous-scan rate limit while logged in
#   - their public monitored_sites always appear in /verified
# Compared case-insensitively. Example:
#   OWNER_EMAILS=cyrusbadde@gmail.com,co-founder@example.com
OWNER_EMAILS=

# --- Operator imprint (§ 5 TMG legal requirement in DE) --------------------
# Until these are filled in, /imprint and /impressum render an admin warning
# instead of fake company details.
COMPANY_NAME=
COMPANY_ADDRESS_LINE_1=
COMPANY_ADDRESS_LINE_2=
COMPANY_POSTAL_CITY=
COMPANY_COUNTRY=
COMPANY_MANAGING_DIRECTOR=
COMPANY_REGISTRY_COURT=
COMPANY_REGISTRY_NUMBER=
COMPANY_VAT_ID=
COMPANY_CONTACT_EMAIL=
