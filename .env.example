# =============================================================================
# AccessibleWebsite / Barrierefreiewebseite — environment variables
# Copy to .env, fill in real values, chmod 600.
# =============================================================================

# --- Database (dedicated Postgres on VPS port 5433) -------------------------
DATABASE_URL=postgres://accessiblewebsite:CHANGEME@127.0.0.1:5433/accessiblewebsite
POSTGRES_PASSWORD=CHANGEME

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380

# --- App URLs (used for canonical, hreflang, email links) -------------------
PUBLIC_SITE_URL_EN=https://accessiblewebsite.net
PUBLIC_SITE_URL_DE=https://barrierefreiewebseite.net

# --- Session + seal signing -------------------------------------------------
SESSION_SECRET=CHANGEME_use_openssl_rand_base64_32
SEAL_JWT_SECRET=CHANGEME_use_openssl_rand_base64_32

# --- OAuth ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
STRIPE_PRICE_GOLD_PRO_MONTHLY=
STRIPE_PRICE_GOLD_PRO_YEARLY=

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EN=team@accessiblewebsite.net
RESEND_FROM_DE=team@barrierefreiewebseite.net

# --- S3-compatible object storage (PDF reports, seal SVGs) -----------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=accessiblewebsite-reports
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Monitoring -------------------------------------------------------------
SENTRY_DSN=
PLAUSIBLE_DOMAIN_EN=accessiblewebsite.net
PLAUSIBLE_DOMAIN_DE=barrierefreiewebseite.net

# --- Cal.com (consultation booking) ----------------------------------------
CALCOM_URL_EN=
CALCOM_URL_DE=

# --- Scanner rate limits & caps --------------------------------------------
SCAN_RATE_ANONYMOUS_PER_HOUR=3
SCAN_RATE_FREE_PER_DAY=10
SCAN_GOLD_MAX_PAGES=250
SCAN_GOLD_PRO_MAX_PAGES=2500

# --- Operator imprint (§ 5 TMG legal requirement in DE) --------------------
# Until these are filled in, /imprint and /impressum render an admin warning
# instead of fake company details.
COMPANY_NAME=
COMPANY_ADDRESS_LINE_1=
COMPANY_ADDRESS_LINE_2=
COMPANY_POSTAL_CITY=
COMPANY_COUNTRY=
COMPANY_MANAGING_DIRECTOR=
COMPANY_REGISTRY_COURT=
COMPANY_REGISTRY_NUMBER=
COMPANY_VAT_ID=
COMPANY_CONTACT_EMAIL=
