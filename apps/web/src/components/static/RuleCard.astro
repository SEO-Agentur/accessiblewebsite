---
interface Props {
  href: string | null;
  tone: 'emerald' | 'amber' | 'ink';
  label: string;
  count: number;
  description: string;
}

const { href, tone, label, count, description } = Astro.props;

// Tailwind safelist (these need to exist literally so the JIT compiler picks
// them up — Tailwind can't resolve template-string class names).
const toneClasses = {
  emerald: {
    bg: 'bg-emerald-50 dark:bg-emerald-900/20',
    border: 'border-emerald-200 dark:border-emerald-700',
    hoverBorder: 'hover:border-emerald-400 focus-visible:border-emerald-400 dark:hover:border-emerald-500',
    label: 'text-emerald-700 dark:text-emerald-300',
    count: 'text-emerald-800 dark:text-emerald-200',
    desc: 'text-emerald-700/80 dark:text-emerald-200/80',
    arrow: 'text-emerald-500',
  },
  amber: {
    bg: 'bg-amber-50 dark:bg-amber-900/20',
    border: 'border-amber-200 dark:border-amber-700',
    hoverBorder: 'hover:border-amber-400 focus-visible:border-amber-400 dark:hover:border-amber-500',
    label: 'text-amber-700 dark:text-amber-300',
    count: 'text-amber-800 dark:text-amber-200',
    desc: 'text-amber-700/80 dark:text-amber-200/80',
    arrow: 'text-amber-500',
  },
  ink: {
    bg: 'bg-ink-50 dark:bg-ink-800',
    border: 'border-ink-200 dark:border-ink-600',
    hoverBorder: 'hover:border-ink-400 focus-visible:border-ink-400 dark:hover:border-ink-400',
    label: 'text-ink-500 dark:text-ink-300',
    count: 'text-ink-700 dark:text-ink-100',
    desc: 'text-ink-500 dark:text-ink-300',
    arrow: 'text-ink-400',
  },
}[tone];

const baseClasses = `group block rounded-lg border p-4 ${toneClasses.bg} ${toneClasses.border}`;
const linkClasses = `${baseClasses} transition ${toneClasses.hoverBorder} hover:shadow-sm cursor-pointer`;
---

{href ? (
  <a href={href} class={linkClasses}>
    <p class={`text-xs uppercase tracking-wide ${toneClasses.label}`}>
      {label}{' '}
      <span aria-hidden="true" class={`${toneClasses.arrow} transition group-hover:translate-x-0.5 inline-block`}>→</span>
    </p>
    <p class={`mt-1 text-2xl font-bold ${toneClasses.count}`}>{count}</p>
    <p class={`mt-1 text-xs ${toneClasses.desc}`}>{description}</p>
  </a>
) : (
  <div class={baseClasses} aria-disabled="true">
    <p class={`text-xs uppercase tracking-wide ${toneClasses.label}`}>{label}</p>
    <p class={`mt-1 text-2xl font-bold ${toneClasses.count}`}>{count}</p>
    <p class={`mt-1 text-xs ${toneClasses.desc}`}>{description}</p>
  </div>
)}
