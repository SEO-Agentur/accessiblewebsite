---
import type { Locale } from '@accessiblewebsite/shared';
import { routePath } from '../../i18n/routes';
import { t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-ink-200 dark:border-ink-800">
  <div class="mx-auto max-w-6xl px-4 py-10 text-sm text-ink-600 dark:text-ink-200">
    <p class="mb-4">{strings.footer.tagline}</p>
    <ul class="flex flex-wrap gap-4">
      <li><a href={routePath('privacy', locale)} class="hover:underline">{strings.footer.privacy}</a></li>
      <li><a href={routePath('terms', locale)} class="hover:underline">{strings.footer.terms}</a></li>
      <li><a href={routePath('imprint', locale)} class="hover:underline">{strings.footer.imprint}</a></li>
      <li><a href={routePath('accessibilityStatement', locale)} class="hover:underline">{strings.footer.accessibilityStatement}</a></li>
    </ul>
    <p class="mt-6 text-xs text-ink-500 dark:text-ink-400">&copy; {year} {strings.meta.siteName}. {strings.footer.rights}</p>
  </div>
</footer>
