---
import Base from '../../layouts/Base.astro';
import RuleCard from '../../components/static/RuleCard.astro';
import { eq, asc } from 'drizzle-orm';
import { scans, scanIssues, type Scan, type ScanIssue } from '@accessiblewebsite/db';
import { MANUAL_PROCEDURES } from '@accessiblewebsite/shared';
import { db } from '../../lib/db';
import { getScanQueue } from '../../lib/queue';
import { t } from '../../i18n';
import { routePath } from '../../i18n/routes';

export const prerender = false;

const locale = Astro.locals.locale;
const isDE = locale === 'de';
const strings = t(locale);

const { id } = Astro.params;
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

if (typeof id !== 'string' || !UUID_RE.test(id)) {
  return new Response(isDE ? 'Scan nicht gefunden' : 'Scan not found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const rows = await db().select().from(scans).where(eq(scans.id, id)).limit(1);
const scan: Scan | undefined = rows[0];
if (!scan) {
  return new Response(isDE ? 'Scan nicht gefunden' : 'Scan not found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

let issues: ScanIssue[] = [];
if (scan.status === 'completed') {
  issues = await db()
    .select()
    .from(scanIssues)
    .where(eq(scanIssues.scanId, id))
    .orderBy(asc(scanIssues.severity), asc(scanIssues.wcagCriterion));
}

// While the scan is still in flight, show position in the queue so the user
// understands the wait. Position 0 means "next up", or "currently running".
let queuePosition: number | null = null;
if (scan.status === 'queued' || scan.status === 'running') {
  try {
    const queue = getScanQueue();
    const waiting = await queue.getWaiting(0, 200);
    const idx = waiting.findIndex((j) => {
      const data = j.data as { scanId?: string };
      return data.scanId === id;
    });
    queuePosition = idx >= 0 ? idx : null;
  } catch {
    // Redis unreachable — fall through, page still renders.
  }
}

const SEVERITY_ORDER = ['critical', 'serious', 'moderate', 'minor'] as const;
const issuesBySeverity = Object.fromEntries(
  SEVERITY_ORDER.map((s) => [s, issues.filter((i) => i.severity === s)]),
) as Record<(typeof SEVERITY_ORDER)[number], ScanIssue[]>;

const targetHost = (() => {
  try {
    return new URL(scan.targetUrl).host;
  } catch {
    return scan.targetUrl;
  }
})();

const score = scan.score ?? 0;
const scoreColour =
  score >= 95 ? 'text-accent-600 dark:text-accent-50'
  : score >= 80 ? 'text-emerald-600 dark:text-emerald-300'
  : score >= 50 ? 'text-amber-600 dark:text-amber-300'
  : 'text-red-600 dark:text-red-400';

const sealTier =
  score >= 95 ? 'gold'
  : score >= 80 ? 'silver'
  : null;

const severityLabel = (s: string): string => {
  if (isDE) {
    return { critical: 'Kritisch', serious: 'Schwerwiegend', moderate: 'Mittel', minor: 'Gering' }[s] ?? s;
  }
  return { critical: 'Critical', serious: 'Serious', moderate: 'Moderate', minor: 'Minor' }[s] ?? s;
};

const severityChipClass = (s: string): string => ({
  critical: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200',
  serious: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200',
  moderate: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-200',
  minor: 'bg-ink-100 text-ink-800 dark:bg-ink-700 dark:text-ink-100',
}[s] ?? 'bg-ink-100');

const isRunning = scan.status === 'queued' || scan.status === 'running';
const isFailed = scan.status === 'failed';
const isComplete = scan.status === 'completed';

// Detect whether this scan completed via the Firecrawl failover (partial
// audit — semantic rules only, no color contrast / focus / touch-target
// verification).
type RuleSummary = { id: string; help: string; wcagCriterion: string };
type RawResults = {
  scanMode?: string;
  passCount?: number;
  incompleteCount?: number;
  inapplicableCount?: number;
  passes?: RuleSummary[];
  incomplete?: RuleSummary[];
  inapplicable?: RuleSummary[];
};
const rawResults = (scan.rawResults ?? null) as RawResults | null;
const isPartialScan = rawResults?.scanMode === 'partial_firecrawl';
const passList = rawResults?.passes ?? [];
const incompleteList = rawResults?.incomplete ?? [];
const inapplicableList = rawResults?.inapplicable ?? [];
const passCount = rawResults?.passCount ?? passList.length;
const incompleteCount = rawResults?.incompleteCount ?? incompleteList.length;
const inapplicableCount = rawResults?.inapplicableCount ?? inapplicableList.length;

// Belt + braces auto-refresh for the in-flight states:
//   1. HTTP Refresh header — fires before any HTML is parsed, survives
//      a stalled body stream
//   2. <meta http-equiv="refresh"> injected via the Base layout's
//      `head` slot — backup for proxies that strip the header
if (isRunning) {
  Astro.response.headers.set('Refresh', '3');
}

const pageTitle = isComplete
  ? `${score}/100 — ${targetHost} — ${strings.meta.siteName}`
  : isRunning
    ? (isDE ? `Scan läuft — ${targetHost}` : `Scan running — ${targetHost}`)
    : (isDE ? `Scan fehlgeschlagen — ${targetHost}` : `Scan failed — ${targetHost}`);

const pageDescription = isComplete
  ? (isDE
      ? `${targetHost} hat ${score}/100 nach WCAG 2.2 AA erreicht. ${scan.totalIssues ?? 0} gefundene Probleme.`
      : `${targetHost} scored ${score}/100 against WCAG 2.2 AA. ${scan.totalIssues ?? 0} issues found.`)
  : (isDE
      ? `Ergebnis-Seite für die Barrierefreiheits-Prüfung von ${targetHost}.`
      : `Result page for the accessibility scan of ${targetHost}.`);
---

<Base title={pageTitle} description={pageDescription}>
  {isRunning && (
    <Fragment slot="head">
      <meta http-equiv="refresh" content="3" />
    </Fragment>
  )}

  <section class="px-4 py-12">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm text-ink-500 dark:text-ink-400">
        <a href={routePath('home', locale)} class="hover:underline">
          {isDE ? 'Startseite' : 'Home'}
        </a>
        {' › '}
        <span aria-current="page">{isDE ? 'Scan' : 'Scan'}</span>
      </p>

      <header class="mt-4">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          {targetHost}
        </h1>
        <p class="mt-1 break-all text-sm text-ink-500 dark:text-ink-400">
          {scan.targetUrl}
        </p>
      </header>

      {isRunning && (
        <div class="mt-10 rounded-xl border border-ink-200 bg-white p-8 text-center dark:border-ink-600 dark:bg-ink-800" aria-live="polite" aria-busy="true">
          <div class="mx-auto inline-block animate-spin rounded-full border-4 border-ink-200 border-t-brand-700 p-4" aria-hidden="true" style="width:48px;height:48px;"></div>
          <h2 class="mt-6 text-xl font-semibold">
            {scan.status === 'queued'
              ? (isDE ? 'In Warteschlange…' : 'Queued…')
              : (isDE ? 'Scan läuft…' : 'Scanning…')}
          </h2>

          {scan.status === 'queued' && queuePosition !== null && (
            <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
              {queuePosition === 0
                ? (isDE ? 'Sie sind als Nächstes dran.' : 'You are next in line.')
                : (isDE
                    ? `${queuePosition} ${queuePosition === 1 ? 'Scan' : 'Scans'} vor Ihnen.`
                    : `${queuePosition} ${queuePosition === 1 ? 'scan' : 'scans'} ahead of you.`)}
            </p>
          )}

          <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
            {isDE
              ? 'Diese Seite aktualisiert sich automatisch. Typische Dauer: 10–30 Sekunden. Maximum: 90 Sekunden — danach markieren wir den Scan automatisch als fehlgeschlagen.'
              : 'This page auto-refreshes. Typical duration: 10–30 seconds. Hard cap: 90 seconds — after that we automatically mark the scan as failed.'}
          </p>
          <p class="mt-3 text-xs text-ink-500 dark:text-ink-400">
            {isDE ? 'Scan-ID: ' : 'Scan ID: '}<code>{scan.id}</code>
          </p>
        </div>
      )}

      {isFailed && (
        <div class="mt-10 rounded-xl border border-red-200 bg-red-50 p-8 dark:border-red-700 dark:bg-red-900/20">
          <h2 class="text-xl font-semibold text-red-800 dark:text-red-200">
            {isDE ? 'Scan fehlgeschlagen' : 'Scan failed'}
          </h2>
          <p class="mt-2 text-sm text-red-700 dark:text-red-200">
            {isDE
              ? 'Wir konnten Ihre Webseite nicht laden. Häufige Gründe: Die URL ist nicht öffentlich erreichbar, die Seite hat ein Captcha, oder die Antwortzeit war über 30 Sekunden.'
              : 'We could not load your site. Common reasons: the URL is not publicly reachable, the page has a captcha, or response time exceeded 30 seconds.'}
          </p>
          <a href={routePath('home', locale)} class="mt-4 inline-block rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800">
            {isDE ? 'Andere URL prüfen' : 'Scan another URL'}
          </a>
        </div>
      )}

      {isComplete && (
        <>
          {isPartialScan && (
            <aside
              role="status"
              class="mt-8 rounded-xl border-2 border-amber-300 bg-amber-50 p-5 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-900/20 dark:text-amber-100"
            >
              <p class="font-semibold">
                {isDE
                  ? 'Teil-Scan (Fallback) — Live-Browser-Tests nicht möglich'
                  : 'Partial scan (failover) — live-browser checks unavailable'}
              </p>
              <p class="mt-2">
                {isDE
                  ? 'Unser primärer Scanner konnte diese Webseite nicht direkt laden (vermutlich Bot-Schutz oder Geo-Sperre). Wir haben über einen Failover die gerenderte HTML-Seite geholt und semantische Prüfungen (Alt-Text, Labels, Überschriften-Hierarchie, ARIA, lang-Attribut, doppelte IDs) durchgeführt. Nicht geprüft: Farbkontrast, Fokus-Sichtbarkeit, Berührungsziel-Größe — diese benötigen einen echten Browser-Layout. Die Bewertung ist daher auf maximal '
                  : "Our primary scanner couldn't load this site directly (likely bot protection or geo-block). We fetched the rendered HTML via a failover and ran the semantic axe-core rules (alt text, labels, heading order, ARIA, lang attribute, duplicate IDs). Not checked: colour contrast, focus visibility, touch target size — those need a real browser layout. The score is capped at "}
                <strong>{isDE ? '80 begrenzt' : '80'}</strong>{isDE ? '.' : ' for this reason.'}
              </p>
              <p class="mt-2 text-xs">
                {isDE
                  ? 'Für eine vollständige WCAG-2.2-AA-Prüfung beauftragen Sie einen Audit über unsere '
                  : 'For a complete WCAG 2.2 AA audit, request a human review via our '}
                <a class="underline" href={routePath('remediation', locale)}>
                  {isDE ? 'Umsetzungs-Seite' : 'remediation page'}
                </a>.
              </p>
            </aside>
          )}

          <section class="mt-8 grid gap-6 sm:grid-cols-3">
            <div class="rounded-xl border border-ink-200 bg-white p-6 sm:col-span-2 dark:border-ink-600 dark:bg-ink-800">
              <p class="text-sm text-ink-500 dark:text-ink-400">
                {isDE ? 'Bewertung' : 'Score'}
              </p>
              <p class={`mt-1 text-6xl font-bold tracking-tight ${scoreColour}`}>
                {score}<span class="text-3xl text-ink-500 dark:text-ink-400">/100</span>
              </p>
              <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
                {sealTier === 'gold' && (
                  <>
                    🥇 {isDE ? 'Gold-Siegel-würdig (≥ 95)' : 'Gold Seal-eligible (≥ 95)'}
                  </>
                )}
                {sealTier === 'silver' && (
                  <>
                    🥈 {isDE ? 'Silber-Siegel-würdig (≥ 80)' : 'Silver Seal-eligible (≥ 80)'}
                  </>
                )}
                {sealTier === null && (
                  <>
                    {isDE
                      ? 'Unter dem Silber-Schwellwert (80). Empfehlung: Umsetzung.'
                      : 'Below the Silver threshold (80). Remediation recommended.'}
                  </>
                )}
              </p>
            </div>
            <div class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-600 dark:bg-ink-800">
              <p class="text-sm text-ink-500 dark:text-ink-400">
                {isDE ? 'Probleme gesamt' : 'Total issues'}
              </p>
              <a
                href="#issues"
                class="mt-1 block text-4xl font-bold hover:underline focus-visible:underline"
              >
                {scan.totalIssues ?? 0}
              </a>
              <ul class="mt-3 space-y-0.5 text-xs">
                {SEVERITY_ORDER.map((sev) => {
                  const count =
                    sev === 'critical' ? (scan.criticalIssues ?? 0)
                    : sev === 'serious' ? (scan.seriousIssues ?? 0)
                    : sev === 'moderate' ? (scan.moderateIssues ?? 0)
                    : (scan.minorIssues ?? 0);
                  if (count === 0) {
                    return (
                      <li class="flex justify-between px-1 py-0.5 text-ink-500 dark:text-ink-400">
                        <span>{severityLabel(sev)}</span>
                        <span>0</span>
                      </li>
                    );
                  }
                  return (
                    <li>
                      <a
                        href={`#severity-${sev}`}
                        class="-mx-1 flex justify-between rounded px-1 py-0.5 hover:bg-ink-100 hover:underline focus-visible:bg-ink-100 dark:hover:bg-ink-700 dark:focus-visible:bg-ink-700"
                      >
                        <span class="text-ink-500 dark:text-ink-400">{severityLabel(sev)}</span>
                        <span class="font-semibold tabular-nums">{count}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </section>

          {(passCount > 0 || incompleteCount > 0 || inapplicableCount > 0) && (
            <section class="mt-6 grid gap-3 sm:grid-cols-3" aria-label={isDE ? 'WCAG-Regeln Übersicht' : 'WCAG rules overview'}>
              <RuleCard
                href={passCount > 0 ? '#passed-audits' : null}
                tone="emerald"
                label={isDE ? 'Bestandene Prüfungen' : 'Passed audits'}
                count={passCount}
                description={isDE ? 'WCAG-Regeln, die diese Seite besteht.' : 'WCAG rules this page passes.'}
              />
              <RuleCard
                href={incompleteCount > 0 ? '#manual-review' : null}
                tone="amber"
                label={isDE ? 'Manuelle Prüfung empfohlen' : 'Manual review recommended'}
                count={incompleteCount}
                description={isDE
                  ? 'Regeln, die automatisch nicht eindeutig prüfbar sind.'
                  : "Rules that automation can't conclusively verify."}
              />
              <RuleCard
                href={inapplicableCount > 0 ? '#not-applicable' : null}
                tone="ink"
                label={isDE ? 'Nicht anwendbar' : 'Not applicable'}
                count={inapplicableCount}
                description={isDE
                  ? 'Regeln ohne passende Elemente auf dieser Seite.'
                  : 'Rules with no matching elements on this page.'}
              />
            </section>
          )}

          {score < 80 && (scan.criticalIssues ?? 0) + (scan.seriousIssues ?? 0) > 0 && (
            <aside class="mt-8 rounded-xl border-2 border-brand-700 bg-brand-50 p-6 dark:bg-brand-900/30">
              <h2 class="text-xl font-bold">
                {isDE
                  ? `Wir fanden ${(scan.criticalIssues ?? 0) + (scan.seriousIssues ?? 0)} ernsthafte Probleme auf ${targetHost}`
                  : `We found ${(scan.criticalIssues ?? 0) + (scan.seriousIssues ?? 0)} serious issues on ${targetHost}`}
              </h2>
              <p class="mt-2 text-sm text-ink-700 dark:text-ink-100">
                {isDE
                  ? 'Unser Team kann sie in 3–4 Wochen beheben — mit Festpreis und 100 %-Garantie. Angebot in 48 Stunden.'
                  : 'Our team can fix them in 3–4 weeks — fixed price, 100% guarantee. Quote in 48 hours.'}
              </p>
              <a
                href={`${routePath('remediation', locale)}?url=${encodeURIComponent(scan.targetUrl)}`}
                class="mt-4 inline-block rounded-md bg-brand-700 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-800"
              >
                {isDE ? 'Kostenloses Angebot anfordern' : 'Get a free quote in 48 hours'}
              </a>
            </aside>
          )}

          {issues.length === 0 ? (
            <p class="mt-10 rounded-lg bg-emerald-50 p-6 text-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">
              {isDE
                ? '🎉 Keine Verstöße gefunden. Diese Webseite ist nach unseren automatischen Tests konform mit WCAG 2.2 AA.'
                : '🎉 No violations found. This site passes our automated WCAG 2.2 AA checks.'}
            </p>
          ) : (
            <section id="issues" class="mt-10 space-y-8 scroll-mt-20">
              {SEVERITY_ORDER.map((sev) => {
                const group = issuesBySeverity[sev];
                if (group.length === 0) return null;
                return (
                  <div id={`severity-${sev}`} class="scroll-mt-20">
                    <h2 class="text-xl font-bold">
                      <span class={`mr-2 inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold ${severityChipClass(sev)}`}>
                        {severityLabel(sev)}
                      </span>
                      <span class="text-ink-600 dark:text-ink-200">({group.length})</span>
                    </h2>
                    <ul class="mt-4 space-y-3">
                      {group.slice(0, 15).map((iss) => (
                        <li class="rounded-lg border border-ink-200 bg-white p-4 dark:border-ink-600 dark:bg-ink-800">
                          <p class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">
                            WCAG {iss.wcagCriterion}
                          </p>
                          <p class="mt-1 font-semibold">{iss.description}</p>
                          {iss.elementSelector && (
                            <p class="mt-2 break-all rounded bg-ink-50 px-2 py-1 font-mono text-xs text-ink-700 dark:bg-ink-900 dark:text-ink-200">
                              {iss.elementSelector}
                            </p>
                          )}
                          {iss.remediationHint && (
                            <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">{iss.remediationHint}</p>
                          )}
                        </li>
                      ))}
                    </ul>
                    {group.length > 15 && (
                      <p class="mt-3 text-sm text-ink-500 dark:text-ink-400">
                        {isDE
                          ? `… und ${group.length - 15} weitere ${severityLabel(sev).toLowerCase()} Probleme.`
                          : `… and ${group.length - 15} more ${severityLabel(sev).toLowerCase()} issues.`}
                      </p>
                    )}
                  </div>
                );
              })}
            </section>
          )}

          <section class="mt-12 space-y-3">
            <h2 class="text-xl font-bold">
              {isDE ? 'Vollständige Regel-Liste' : 'Full rule breakdown'}
            </h2>
            <p class="text-sm text-ink-600 dark:text-ink-200">
              {isDE
                ? 'Jede Regel, die wir geprüft haben — bestanden, manuelle Prüfung empfohlen, oder ohne passende Elemente. Wir paywallen diese Liste nicht.'
                : "Every rule we checked — passed, manual review recommended, or with no matching elements on this page. We don't paywall this list."}
            </p>

            {passList.length > 0 && (
              <details id="passed-audits" class="group scroll-mt-20 rounded-xl border border-emerald-200 bg-emerald-50/50 dark:border-emerald-700 dark:bg-emerald-900/10">
                <summary class="cursor-pointer rounded-xl px-4 py-3 text-sm font-semibold text-emerald-800 hover:bg-emerald-50 dark:text-emerald-200 dark:hover:bg-emerald-900/20">
                  ✓ {isDE ? 'Bestandene Prüfungen' : 'Passed audits'} ({passList.length})
                </summary>
                <ol class="space-y-1 px-6 pb-4 text-sm text-ink-600 dark:text-ink-200">
                  {passList.map((r, i) => (
                    <li class="flex gap-2">
                      <span class="text-ink-500 dark:text-ink-400 tabular-nums">{i + 1}.</span>
                      <span>{r.help}</span>
                    </li>
                  ))}
                </ol>
              </details>
            )}

            {incompleteList.length > 0 && (
              <details id="manual-review" class="group scroll-mt-20 rounded-xl border border-amber-200 bg-amber-50/50 dark:border-amber-700 dark:bg-amber-900/10">
                <summary class="cursor-pointer rounded-xl px-4 py-3 text-sm font-semibold text-amber-800 hover:bg-amber-50 dark:text-amber-200 dark:hover:bg-amber-900/20">
                  ⚠ {isDE ? 'Manuelle Prüfung empfohlen' : 'Manual review recommended'} ({incompleteList.length})
                </summary>
                <ol class="space-y-1 px-6 pb-4 text-sm text-ink-600 dark:text-ink-200">
                  {incompleteList.map((r, i) => (
                    <li class="flex gap-2">
                      <span class="text-ink-500 dark:text-ink-400 tabular-nums">{i + 1}.</span>
                      <span>{r.help}</span>
                    </li>
                  ))}
                </ol>
              </details>
            )}

            <details class="group rounded-xl border border-ink-200 bg-white dark:border-ink-600 dark:bg-ink-800">
              <summary class="cursor-pointer rounded-xl px-4 py-3 text-sm font-semibold hover:bg-ink-50 dark:hover:bg-ink-700">
                ⚙ {isDE
                  ? 'Prozeduren, die Automation nicht prüfen kann'
                  : 'Procedures automation cannot verify'}{' '}
                ({MANUAL_PROCEDURES.length})
              </summary>
              <div class="px-6 pb-4 text-sm text-ink-600 dark:text-ink-200">
                <p class="mb-3 text-xs italic text-ink-500 dark:text-ink-300">
                  {isDE
                    ? 'WCAG-Kriterien, die nur ein Mensch prüfen kann. Wir paywallen sie nicht — wir verkaufen den Review selbst.'
                    : 'WCAG criteria that only a human reviewer can verify. We do not paywall them — we sell the review itself.'}
                </p>
                <ol class="space-y-3">
                  {MANUAL_PROCEDURES.map((p, i) => (
                    <li>
                      <p>
                        <span class="text-ink-500 dark:text-ink-400 tabular-nums">{i + 1}.</span>{' '}
                        <span class="mr-2 inline-block rounded-full bg-ink-100 px-2 py-0.5 text-xs font-semibold dark:bg-ink-700">
                          {p.levels.join('/')}
                        </span>
                        <span class="font-semibold">{p.title[locale]}</span>{' '}
                        <span class="text-xs text-ink-500 dark:text-ink-400">WCAG {p.wcagCriteria.join(', ')}</span>
                      </p>
                      <p class="mt-1 pl-6 text-xs">{p.description[locale]}</p>
                    </li>
                  ))}
                </ol>
              </div>
            </details>

            {inapplicableList.length > 0 && (
              <details id="not-applicable" class="group scroll-mt-20 rounded-xl border border-ink-200 bg-white dark:border-ink-600 dark:bg-ink-800">
                <summary class="cursor-pointer rounded-xl px-4 py-3 text-sm font-semibold hover:bg-ink-50 dark:hover:bg-ink-700">
                  ⊘ {isDE ? 'Nicht anwendbar' : 'Not applicable'} ({inapplicableList.length})
                </summary>
                <ol class="space-y-1 px-6 pb-4 text-sm text-ink-600 dark:text-ink-200">
                  {inapplicableList.map((r, i) => (
                    <li class="flex gap-2">
                      <span class="text-ink-500 dark:text-ink-400 tabular-nums">{i + 1}.</span>
                      <span>{r.help}</span>
                    </li>
                  ))}
                </ol>
              </details>
            )}
          </section>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href={`/scan/${scan.id}.txt`}
              class="inline-flex items-center gap-2 rounded-md border border-ink-200 bg-white px-4 py-2 text-sm font-semibold hover:bg-ink-50 dark:border-ink-600 dark:bg-ink-800 dark:hover:bg-ink-700"
              download={`scan-${scan.id}.txt`}
            >
              <span aria-hidden="true">📄</span>
              {isDE ? 'Bericht als Text (.txt) herunterladen' : 'Download report as text (.txt)'}
            </a>
            <a
              href={`/scan/${scan.id}.txt`}
              class="inline-flex items-center gap-2 rounded-md border border-ink-200 bg-white px-4 py-2 text-sm font-semibold hover:bg-ink-50 dark:border-ink-600 dark:bg-ink-800 dark:hover:bg-ink-700"
              target="_blank"
              rel="noopener"
            >
              <span aria-hidden="true">👁</span>
              {isDE ? 'Im Browser ansehen' : 'View in browser'}
            </a>
          </div>

          <p class="mt-12 text-xs text-ink-500 dark:text-ink-400">
            {isDE ? 'Scan abgeschlossen am ' : 'Scan completed at '}
            {scan.completedAt
              ? scan.completedAt.toLocaleString(isDE ? 'de-DE' : 'en-GB')
              : '—'}
            {' · '}
            {isDE ? 'Scan-ID: ' : 'Scan ID: '}<code>{scan.id}</code>
          </p>
        </>
      )}
    </div>
  </section>
</Base>
