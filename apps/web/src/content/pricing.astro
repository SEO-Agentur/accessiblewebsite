---
import type { Locale } from '@accessiblewebsite/shared';
import { routePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';

// Surface errors bounced back from the checkout/billing endpoints so the user
// understands why they landed back on /pricing instead of on Stripe.
const url = new URL(Astro.request.url);
const errorCode = url.searchParams.get('error');
const cancelled = url.searchParams.get('cancelled') === '1';
const errorBanner: { tone: 'warning' | 'info'; message: string } | null =
  errorCode === 'tier_required'
    ? {
        tone: 'warning',
        message: isDE
          ? 'Vollständige Site-Scans sind in Gold oder Gold Pro enthalten. Wählen Sie unten einen Plan, um fortzufahren.'
          : 'Full-site scans are part of Gold or Gold Pro. Pick a plan below to continue.',
      }
    : errorCode === 'billing_not_configured'
      ? {
          tone: 'warning',
          message: isDE
            ? 'Zahlungsabwicklung ist aktuell nicht aktiv. Bitte versuchen Sie es später erneut oder kontaktieren Sie uns.'
            : 'Billing is not active right now. Please try again later or contact us.',
        }
      : errorCode === 'price_not_configured'
        ? {
            tone: 'warning',
            message: isDE
              ? 'Für diesen Tarif ist noch keine Preis-ID hinterlegt. Bitte kontaktieren Sie uns.'
              : "This plan's price hasn't been configured yet. Please contact us.",
          }
        : errorCode === 'invalid_tier'
          ? {
              tone: 'warning',
              message: isDE
                ? 'Ungültige Auswahl. Bitte wählen Sie einen Tarif unten.'
                : 'Invalid selection. Please pick a plan below.',
            }
          : cancelled
            ? {
                tone: 'info',
                message: isDE
                  ? 'Bezahlung abgebrochen. Sie können den Vorgang jederzeit erneut starten.'
                  : 'Checkout cancelled. You can start again whenever you like.',
              }
            : null;

const fmtPrice = (eur: number, period?: 'mo' | 'yr' | 'once'): string => {
  const num = isDE
    ? eur.toLocaleString('de-DE', { minimumFractionDigits: 0 })
    : eur.toLocaleString('en-US');
  const suffix =
    period === 'mo' ? (isDE ? '/Monat' : '/mo')
    : period === 'yr' ? (isDE ? '/Jahr' : '/yr')
    : period === 'once' ? (isDE ? ' einmalig' : ' one-time')
    : '';
  return `€${num}${suffix}`;
};

// Service schema for the remediation packages (each tier is a separate Service).
const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': '#monitoring-silver',
      name: isDE ? 'Silber-Siegel — Monitoring (kostenlos)' : 'Silver Seal — Monitoring (free)',
      provider: { '@type': 'Organization', name: 'AccessibleWebsite' },
      areaServed: ['EU', 'DACH', 'US', 'UK'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    },
    {
      '@type': 'Service',
      '@id': '#monitoring-gold',
      name: 'Gold Seal Monitoring',
      provider: { '@type': 'Organization', name: 'AccessibleWebsite' },
      offers: { '@type': 'Offer', price: '19', priceCurrency: 'EUR', billingDuration: 'P1M' },
    },
    {
      '@type': 'Service',
      '@id': '#remediation-business',
      name: isDE ? 'Business Fix — WCAG 2.2 AA Umsetzung' : 'Business Fix — WCAG 2.2 AA Remediation',
      provider: { '@type': 'Organization', name: 'AccessibleWebsite' },
      offers: { '@type': 'Offer', price: '2499', priceCurrency: 'EUR' },
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<section class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    {errorBanner && (
      <div
        role={errorBanner.tone === 'warning' ? 'alert' : 'status'}
        class={`mb-8 rounded-lg border p-4 text-sm ${
          errorBanner.tone === 'warning'
            ? 'border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-100'
            : 'border-brand-200 bg-brand-50 text-brand-900 dark:border-brand-500/40 dark:bg-brand-500/10 dark:text-brand-100'
        }`}
      >
        {errorBanner.message}
      </div>
    )}
    <header class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {isDE ? 'Transparente Preise. Keine Aufschläge auf Token.' : 'Transparent pricing. No token markups.'}
      </h1>
      <p class="mt-4 text-lg text-ink-600 dark:text-ink-200">
        {isDE
          ? 'Monitoring ab kostenlos. Umsetzung zum Festpreis. Sie zahlen für Ergebnisse, nicht für Versprechen.'
          : 'Monitoring starts free. Remediation is fixed-price. You pay for outcomes, not promises.'}
      </p>
    </header>

    <h2 class="mt-16 text-2xl font-bold">
      {isDE ? 'Monitoring & Siegel' : 'Monitoring & Seal'}
    </h2>
    <p class="mt-2 text-ink-600 dark:text-ink-200">
      {isDE
        ? 'Automatische, wiederkehrende Prüfungen. Live-Siegel auf Ihrer Webseite.'
        : 'Automated recurring scans. A live seal on your website.'}
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <article class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-600 dark:bg-ink-800">
        <h3 class="text-xl font-semibold">{isDE ? 'Silber' : 'Silver'}</h3>
        <p class="mt-1 text-3xl font-bold">{fmtPrice(0)}</p>
        <p class="text-sm text-ink-500 dark:text-ink-400">{isDE ? 'Für immer kostenlos' : 'Forever free'}</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>✓ {isDE ? 'Startseiten-Prüfung' : 'Homepage scan'}</li>
          <li>✓ {isDE ? 'Silber-Siegel, 90 Tage gültig' : 'Silver Seal, valid 90 days'}</li>
          <li>✓ {isDE ? 'Listung im öffentlichen Verzeichnis' : 'Listed in public directory'}</li>
          <li>✓ {isDE ? 'PDF-Bericht zum Download' : 'Downloadable PDF report'}</li>
        </ul>
        <a href={routePath('signup', locale)} class="mt-6 block rounded-md border border-ink-200 px-4 py-2.5 text-center text-sm font-semibold hover:bg-ink-50 dark:border-ink-600 dark:hover:bg-ink-800">
          {isDE ? 'Kostenlos starten' : 'Start free'}
        </a>
      </article>

      <article class="relative rounded-xl border-2 border-brand-700 bg-white p-6 dark:bg-ink-800">
        <span class="absolute -top-3 left-6 rounded-full bg-brand-700 px-3 py-1 text-xs font-bold text-white">
          {isDE ? 'BELIEBT' : 'POPULAR'}
        </span>
        <h3 class="text-xl font-semibold">Gold</h3>
        <p class="mt-1 text-3xl font-bold">{fmtPrice(9, 'mo')}</p>
        <p class="text-sm text-ink-500 dark:text-ink-400">
          {isDE ? 'oder ' : 'or '}{fmtPrice(90, 'yr')} <span class="text-accent-600">(−17%)</span>
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>✓ {isDE ? 'Monatlicher Vollscan, bis 250 Seiten' : 'Monthly full-site crawl, up to 250 pages'}</li>
          <li>✓ {isDE ? 'Live Gold-Siegel (Status-aktualisierend)' : 'Live Gold Seal (status-updating)'}</li>
          <li>✓ {isDE ? 'E-Mail-Alarme bei Regressionen' : 'Email alerts on regression'}</li>
          <li>✓ {isDE ? 'Priorisierte Verzeichnislistung' : 'Prioritised directory listing'}</li>
          <li>✓ {isDE ? 'Monatliche PDF-Berichte' : 'Monthly PDF reports'}</li>
        </ul>
        <form method="POST" action="/api/v1/billing/checkout" class="mt-6">
          <input type="hidden" name="tier" value="gold" />
          <fieldset class="mb-3 flex gap-3 text-sm">
            <legend class="sr-only">{isDE ? 'Abrechnung' : 'Billing cadence'}</legend>
            <label class="inline-flex items-center gap-1.5">
              <input type="radio" name="cadence" value="monthly" checked class="accent-brand-700" />
              <span>{isDE ? 'Monatlich' : 'Monthly'}</span>
            </label>
            <label class="inline-flex items-center gap-1.5">
              <input type="radio" name="cadence" value="yearly" class="accent-brand-700" />
              <span>{isDE ? 'Jährlich' : 'Yearly'} <span class="text-accent-600">−17%</span></span>
            </label>
          </fieldset>
          <button type="submit" class="block w-full rounded-md bg-brand-700 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-brand-800">
            {isDE ? 'Gold abonnieren' : 'Subscribe to Gold'}
          </button>
        </form>
      </article>

      <article class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-600 dark:bg-ink-800">
        <h3 class="text-xl font-semibold">Gold Pro</h3>
        <p class="mt-1 text-3xl font-bold">{fmtPrice(19, 'mo')}</p>
        <p class="text-sm text-ink-500 dark:text-ink-400">
          {isDE ? 'oder ' : 'or '}{fmtPrice(190, 'yr')} <span class="text-accent-600">(−17%)</span>
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>✓ {isDE ? 'Monatlicher Scan, bis 2.500 Seiten' : 'Monthly scan, up to 2,500 pages'}</li>
          <li>✓ {isDE ? 'API-Zugang' : 'API access'}</li>
          <li>✓ {isDE ? 'Multi-User-Dashboard' : 'Multi-user dashboard'}</li>
          <li>✓ {isDE ? 'White-Label PDF-Berichte' : 'White-label PDF reports'}</li>
          <li>✓ {isDE ? 'Slack / Webhook Alerts' : 'Slack / webhook alerts'}</li>
        </ul>
        <form method="POST" action="/api/v1/billing/checkout" class="mt-6">
          <input type="hidden" name="tier" value="gold_pro" />
          <fieldset class="mb-3 flex gap-3 text-sm">
            <legend class="sr-only">{isDE ? 'Abrechnung' : 'Billing cadence'}</legend>
            <label class="inline-flex items-center gap-1.5">
              <input type="radio" name="cadence" value="monthly" checked class="accent-brand-700" />
              <span>{isDE ? 'Monatlich' : 'Monthly'}</span>
            </label>
            <label class="inline-flex items-center gap-1.5">
              <input type="radio" name="cadence" value="yearly" class="accent-brand-700" />
              <span>{isDE ? 'Jährlich' : 'Yearly'} <span class="text-accent-600">−17%</span></span>
            </label>
          </fieldset>
          <button type="submit" class="block w-full rounded-md border border-ink-200 px-4 py-2.5 text-center text-sm font-semibold hover:bg-ink-50 dark:border-ink-600 dark:hover:bg-ink-800">
            {isDE ? 'Gold Pro abonnieren' : 'Subscribe to Gold Pro'}
          </button>
        </form>
      </article>
    </div>

    <p class="mt-6 text-sm text-ink-500 dark:text-ink-400">
      {isDE
        ? 'Enterprise (unbegrenzte Seiten, mehrere Domains, dedizierte Ansprechperson) ab '
        : 'Enterprise (unlimited pages, multi-domain, dedicated success manager) from '}
      {fmtPrice(199, 'mo')} —
      <a href={routePath('remediation', locale)} class="underline">
        {isDE ? 'kontaktieren Sie uns' : 'contact us'}
      </a>.
    </p>

    <h2 class="mt-20 text-2xl font-bold">
      {isDE ? 'Umsetzung (Remediation)' : 'Remediation (one-time)'}
    </h2>
    <p class="mt-2 text-ink-600 dark:text-ink-200">
      {isDE
        ? 'Wenn Sie durchgefallen sind. Echte Code-Korrekturen durch Barrierefreiheits-Fachkräfte. Keine Overlay-Widgets.'
        : 'If you failed. Real code fixes by accessibility specialists. No overlay widgets.'}
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <article class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-600 dark:bg-ink-800">
        <h3 class="text-xl font-semibold">Starter Fix</h3>
        <p class="mt-1 text-3xl font-bold">{fmtPrice(499, 'once')}</p>
        <p class="text-sm text-ink-500 dark:text-ink-400">
          {isDE ? 'Bis 10 Seiten — Lieferung 7–10 Werktage' : 'Up to 10 pages — 7–10 business days'}
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>✓ {isDE ? 'Manuelle Prüfung durch Fachkraft' : 'Manual audit by specialist'}</li>
          <li>✓ {isDE ? 'Code-Korrekturen als Pull Request' : 'Code fixes delivered as PR'}</li>
          <li>✓ {isDE ? 'Silber-Siegel inklusive' : 'Silver Seal included'}</li>
          <li>✓ {isDE ? '30-Tage-Nachsorge' : '30-day follow-up support'}</li>
        </ul>
        <a href={routePath('remediation', locale)} class="mt-6 block rounded-md border border-ink-200 px-4 py-2.5 text-center text-sm font-semibold hover:bg-ink-50 dark:border-ink-600 dark:hover:bg-ink-800">
          {isDE ? 'Starter anfragen' : 'Get Starter quote'}
        </a>
      </article>

      <article class="relative rounded-xl border-2 border-brand-700 bg-white p-6 dark:bg-ink-800">
        <span class="absolute -top-3 left-6 rounded-full bg-brand-700 px-3 py-1 text-xs font-bold text-white">
          {isDE ? 'BELIEBT' : 'MOST POPULAR'}
        </span>
        <h3 class="text-xl font-semibold">Business Fix</h3>
        <p class="mt-1 text-3xl font-bold">{fmtPrice(2499, 'once')}</p>
        <p class="text-sm text-ink-500 dark:text-ink-400">
          {isDE ? 'Bis 100 Seiten — Lieferung 3–4 Wochen' : 'Up to 100 pages — 3–4 weeks'}
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>✓ {isDE ? 'Vollständige WCAG 2.2 AA Konformität' : 'Full WCAG 2.2 AA conformance'}</li>
          <li>✓ {isDE ? 'NVDA + VoiceOver Tests durch Menschen' : 'Manual NVDA + VoiceOver testing'}</li>
          <li>✓ {isDE ? 'Tastatur-Navigations-Audit' : 'Keyboard navigation audit'}</li>
          <li>✓ {isDE ? '12 Monate Gold-Siegel (Wert 228 €)' : '12 months Gold Seal (worth €228)'}</li>
          <li>✓ {isDE ? 'ADA/EAA Konformitäts-Dokumentation' : 'ADA/EAA compliance documentation'}</li>
        </ul>
        <a href={routePath('remediation', locale)} class="mt-6 block rounded-md bg-brand-700 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-brand-800">
          {isDE ? 'Business anfragen' : 'Get Business quote'}
        </a>
      </article>

      <article class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-600 dark:bg-ink-800">
        <h3 class="text-xl font-semibold">Enterprise Fix</h3>
        <p class="mt-1 text-3xl font-bold">{isDE ? 'ab ' : 'from '}{fmtPrice(7500)}</p>
        <p class="text-sm text-ink-500 dark:text-ink-400">
          {isDE ? 'Unbegrenzte Seiten — individueller Zeitplan' : 'Unlimited pages — custom timeline'}
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>✓ {isDE ? 'Mehrere Domains, Multi-Brand' : 'Multi-domain, multi-brand'}</li>
          <li>✓ {isDE ? 'Dedizierte Beratung' : 'Dedicated consultant'}</li>
          <li>✓ {isDE ? 'VPAT-Erstellung' : 'VPAT preparation'}</li>
          <li>✓ {isDE ? 'Quartalsweise Re-Audits, 12 Monate' : 'Quarterly re-audits for 12 months'}</li>
          <li>✓ {isDE ? 'Schulung für Ihre Entwickler' : 'Developer training session'}</li>
        </ul>
        <a href={routePath('remediation', locale)} class="mt-6 block rounded-md border border-ink-200 px-4 py-2.5 text-center text-sm font-semibold hover:bg-ink-50 dark:border-ink-600 dark:hover:bg-ink-800">
          {isDE ? 'Beratung anfragen' : 'Request consultation'}
        </a>
      </article>
    </div>

    <div class="mt-10 rounded-lg bg-accent-50 p-6 text-accent-700 dark:bg-accent-700/10 dark:text-accent-50">
      <p class="font-semibold">
        {isDE ? '100 %-Garantie' : '100% guarantee'}
      </p>
      <p class="mt-1 text-sm">
        {isDE
          ? 'Wenn Ihre Webseite nach der Umsetzung den Test nicht besteht, erstatten wir den vollen Betrag.'
          : "If your site doesn't pass the post-remediation scan, we refund in full."}
      </p>
    </div>

    <h2 class="mt-20 text-2xl font-bold">{isDE ? 'Zusatzleistungen' : 'Add-ons'}</h2>
    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="rounded-lg border border-ink-200 p-4 dark:border-ink-600">
        <dt class="font-semibold">{isDE ? 'VPAT-Erstellung' : 'VPAT preparation'}</dt>
        <dd class="mt-1 text-sm text-ink-600 dark:text-ink-200">{fmtPrice(1200, 'once')}</dd>
      </div>
      <div class="rounded-lg border border-ink-200 p-4 dark:border-ink-600">
        <dt class="font-semibold">{isDE ? 'Barrierefreiheits-Erklärung (Recht)' : 'Accessibility statement drafting'}</dt>
        <dd class="mt-1 text-sm text-ink-600 dark:text-ink-200">{fmtPrice(350, 'once')}</dd>
      </div>
      <div class="rounded-lg border border-ink-200 p-4 dark:border-ink-600">
        <dt class="font-semibold">{isDE ? 'Entwickler-Workshop (2 h, aufgezeichnet)' : 'Developer workshop (2hr, recorded)'}</dt>
        <dd class="mt-1 text-sm text-ink-600 dark:text-ink-200">{fmtPrice(600, 'once')}</dd>
      </div>
      <div class="rounded-lg border border-ink-200 p-4 dark:border-ink-600">
        <dt class="font-semibold">{isDE ? 'Express-Lieferung (unter 5 Werktage)' : 'Rush delivery (under 5 business days)'}</dt>
        <dd class="mt-1 text-sm text-ink-600 dark:text-ink-200">+40 %</dd>
      </div>
      <div class="rounded-lg border border-ink-200 p-4 dark:border-ink-600 sm:col-span-2">
        <dt class="font-semibold">{isDE ? 'Nur Umsetzungs-Anleitung (kein Code)' : 'Remediation Guide only (no implementation)'}</dt>
        <dd class="mt-1 text-sm text-ink-600 dark:text-ink-200">
          {fmtPrice(349, 'once')} —
          {isDE
            ? ' detaillierte, codespezifische Anweisungen für Ihre eigenen Entwickler.'
            : ' detailed, code-specific instructions for your own developers.'}
        </dd>
      </div>
    </dl>

    <div class="mt-16 text-center">
      <a href={routePath('remediation', locale)} class="inline-block rounded-md bg-brand-700 px-8 py-4 text-base font-semibold text-white hover:bg-brand-800">
        {isDE ? 'Kostenloses Angebot in 48 Stunden' : 'Get a free quote in 48 hours'}
      </a>
    </div>
  </div>
</section>
