---
import type { Locale } from '@accessiblewebsite/shared';
import { eq, asc } from 'drizzle-orm';
import { staff } from '@accessiblewebsite/db';
import { db } from '../lib/db';
import { routePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';

const teamRows = await db()
  .select()
  .from(staff)
  .where(eq(staff.profileVisibleInTeamPage, true))
  .orderBy(asc(staff.fullName));
---

<section class="px-4 py-16">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-4xl font-bold tracking-tight">{isDE ? 'Das Team' : 'The team'}</h1>
    <p class="mt-4 text-lg text-ink-600 dark:text-ink-200">
      {isDE
        ? 'Zertifizierte Fachkräfte mit nachweisbarer Erfahrung. Keine Outsourcer, keine versteckten Subunternehmer.'
        : 'Certified specialists with demonstrable experience. No outsourcers, no hidden subcontractors.'}
    </p>

    {teamRows.length === 0 ? (
      <div class="mt-12 rounded-xl border-2 border-dashed border-ink-200 p-12 text-center dark:border-ink-600">
        <p class="text-lg font-semibold">
          {isDE ? 'Team-Profile in Kürze' : 'Team profiles coming online'}
        </p>
        <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
          {isDE
            ? 'Wir veröffentlichen jede Fachkraft mit echtem Namen, Foto, Zertifizierungen und LinkedIn — sobald die Profile fertig sind.'
            : 'We publish every specialist with their real name, photo, certifications, and LinkedIn — as soon as each profile is finalised.'}
        </p>
        <p class="mt-4 text-sm">
          <a href={routePath('about', locale)} class="font-semibold text-accent-600 hover:underline dark:text-accent-50">
            {isDE ? 'Über uns lesen' : 'Read About us'} →
          </a>
        </p>
      </div>
    ) : (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {teamRows.map((person) => (
          <article class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-600 dark:bg-ink-800">
            {person.photoUrl && (
              <img src={person.photoUrl} alt={`${person.fullName}`} width="80" height="80" class="mb-3 h-20 w-20 rounded-full object-cover" loading="lazy" decoding="async" />
            )}
            <h2 class="text-xl font-semibold">{person.fullName}</h2>
            <p class="text-sm capitalize text-accent-600 dark:text-accent-50">{person.role}</p>
            {(isDE ? person.bioDe : person.bioEn) && (
              <p class="mt-3 text-sm text-ink-600 dark:text-ink-200">
                {isDE ? person.bioDe : person.bioEn}
              </p>
            )}
            {person.certifications && person.certifications.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2 text-xs">
                {person.certifications.map((cert) => (
                  <li class="rounded-full bg-ink-100 px-2 py-1 dark:bg-ink-700">{cert}</li>
                ))}
              </ul>
            )}
            {person.linkedinUrl && (
              <a href={person.linkedinUrl} rel="noopener" target="_blank" class="mt-4 inline-block text-sm font-semibold text-accent-600 hover:underline dark:text-accent-50">
                LinkedIn →
              </a>
            )}
          </article>
        ))}
      </div>
    )}

    <div class="mt-12 rounded-xl border border-ink-200 p-6 dark:border-ink-600">
      <h2 class="text-xl font-bold">{isDE ? 'Was die Zertifizierungen bedeuten' : 'What the certifications mean'}</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="font-semibold">IAAP CPACC — Certified Professional in Accessibility Core Competencies</dt>
          <dd class="text-ink-600 dark:text-ink-200">
            {isDE
              ? 'Breite Prüfung der Grundlagen: Behinderungen, Standards, Recht, Geschäftsstrategien. Verliehen von der International Association of Accessibility Professionals.'
              : 'Broad exam of fundamentals: disabilities, standards, law, business strategy. Awarded by the International Association of Accessibility Professionals.'}
          </dd>
        </div>
        <div>
          <dt class="font-semibold">IAAP WAS — Web Accessibility Specialist</dt>
          <dd class="text-ink-600 dark:text-ink-200">
            {isDE
              ? 'Technisches Spezialisten-Examen: WCAG-Erfolgskriterien im Detail, ARIA, Assistive Technology, Test-Methodik.'
              : 'Technical specialist exam: WCAG success criteria in depth, ARIA, assistive technology, test methodology.'}
          </dd>
        </div>
      </dl>
      <p class="mt-4 text-xs text-ink-400">
        {isDE ? 'Quelle: ' : 'Source: '}
        <a class="underline" rel="noopener" href="https://www.accessibilityassociation.org/s/certification">IAAP Certification</a>
      </p>
    </div>

    <div class="mt-16 text-center">
      <a href={routePath('remediation', locale)} class="inline-block rounded-md bg-accent-500 px-6 py-3 text-base font-semibold text-white hover:bg-accent-600">
        {isDE ? 'Mit dem Team arbeiten' : 'Work with the team'}
      </a>
    </div>
  </div>
</section>
