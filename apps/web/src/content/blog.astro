---
import type { Locale } from '@accessiblewebsite/shared';
import { getCollection } from 'astro:content';
import { routePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.language === locale)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const fmtDate = (d: Date): string =>
  d.toLocaleDateString(isDE ? 'de-DE' : 'en-GB', {
    day: 'numeric',
    month: isDE ? 'long' : 'short',
    year: 'numeric',
  });
---

<section class="px-4 py-16">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight">Blog</h1>
    <p class="mt-4 text-lg text-ink-600 dark:text-ink-200">
      {isDE
        ? 'Originalforschung und praktische Leitfäden zu Web-Barrierefreiheit, WCAG 2.2 AA und den Gesetzen, die uns alle betreffen. Jeder Beitrag von Barrierefreiheits-Fachkräften, datiert und mit Quellen.'
        : 'Original research and practical guides on web accessibility, WCAG 2.2 AA, and the laws that affect us all. Every post by accessibility specialists, dated, with sources cited.'}
    </p>

    {posts.length === 0 ? (
      <div class="mt-12 rounded-xl border-2 border-dashed border-ink-200 p-12 text-center dark:border-ink-600">
        <p class="text-lg font-semibold">
          {isDE ? 'Noch keine Beiträge in dieser Sprache' : 'No posts in this language yet'}
        </p>
        <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
          {isDE
            ? 'Während wir den Blog aufbauen, sind unsere ausführlichsten Inhalte in der '
            : 'While we build out the blog, our deepest content lives in the '}
          <a href={routePath('methodology', locale)} class="underline">{isDE ? 'Methodik' : 'methodology'}</a>
          {isDE ? '-Seite und auf der ' : ' page and on the '}
          <a href={routePath('legalLandscape', locale)} class="underline">{isDE ? 'Rechtslage' : 'legal-landscape'}</a>
          {isDE ? '-Seite.' : ' page.'}
        </p>
      </div>
    ) : (
      <div class="mt-12 space-y-8">
        {posts.map((post) => (
          <article class="border-b border-ink-200 pb-8 dark:border-ink-700">
            <p class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">
              <time datetime={post.data.publishedAt.toISOString()}>
                {fmtDate(post.data.publishedAt)}
              </time>
              <span class="ml-2 text-ink-500 dark:text-ink-400">· {post.data.author}</span>
            </p>
            <h2 class="mt-2 text-xl font-semibold">
              <a href={`${routePath('blog', locale)}/${post.id}`} class="hover:underline">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">{post.data.description}</p>
            <a href={`${routePath('blog', locale)}/${post.id}`} class="mt-3 inline-block text-sm font-semibold text-brand-700 hover:underline dark:text-brand-200">
              {isDE ? 'Weiterlesen' : 'Read more'} →
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
