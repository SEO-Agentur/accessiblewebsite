---
import type { Locale } from '@accessiblewebsite/shared';
import { getCollection } from 'astro:content';
import { routePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';

const studies = (await getCollection('caseStudies'))
  .filter((s) => !s.data.draft && s.data.language === locale)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<section class="px-4 py-16">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-4xl font-bold tracking-tight">
      {isDE ? 'Fallstudien' : 'Case studies'}
    </h1>
    <p class="mt-4 text-lg text-ink-600 dark:text-ink-200">
      {isDE
        ? 'Echte Bewertungen, echte Zeitrahmen, datierte Vergleiche. Referenz-Kontakte auf Anfrage.'
        : 'Real scores, real timelines, dated comparisons. Reference contacts available on request.'}
    </p>

    {studies.length === 0 ? (
      <div class="mt-12 rounded-xl border-2 border-dashed border-ink-200 p-12 text-center dark:border-ink-600">
        <p class="text-lg font-semibold">
          {isDE ? 'Erste Fallstudien in Vorbereitung' : 'First case studies in preparation'}
        </p>
        <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
          {isDE
            ? 'Wir veröffentlichen Fallstudien nur mit ausdrücklicher Zustimmung des Kunden und mit verifizierbaren Vorher/Nachher-Werten.'
            : 'We publish case studies only with explicit client consent and with verifiable before/after numbers.'}
        </p>
        <p class="mt-4 text-sm">
          <a href={routePath('remediation', locale)} class="font-semibold text-brand-700 hover:underline dark:text-brand-200">
            {isDE ? 'Mit uns die erste werden →' : 'Become our first case study →'}
          </a>
        </p>
      </div>
    ) : (
      <div class="mt-12 space-y-6">
        {studies.map((s) => (
          <article class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-600 dark:bg-ink-800">
            <p class="text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">
              {s.data.industry}{s.data.country ? ` · ${s.data.country}` : ''}
            </p>
            <h2 class="mt-1 text-xl font-bold">
              <a href={`${routePath('caseStudies', locale)}/${s.id}`} class="hover:underline">
                {s.data.title}
              </a>
            </h2>
            <p class="mt-3 text-sm text-ink-600 dark:text-ink-200">{s.data.description}</p>
            <dl class="mt-4 grid grid-cols-3 gap-4 text-sm">
              <div>
                <dt class="text-ink-500 dark:text-ink-400">{isDE ? 'Vorher' : 'Before'}</dt>
                <dd class="mt-1 text-2xl font-bold text-red-600 dark:text-red-400">{s.data.beforeScore}/100</dd>
              </div>
              <div>
                <dt class="text-ink-500 dark:text-ink-400">{isDE ? 'Nachher' : 'After'}</dt>
                <dd class="mt-1 text-2xl font-bold text-accent-600 dark:text-accent-50">{s.data.afterScore}/100</dd>
              </div>
              <div>
                <dt class="text-ink-500 dark:text-ink-400">{isDE ? 'Dauer' : 'Duration'}</dt>
                <dd class="mt-1 text-2xl font-bold">
                  {s.data.durationDays} {isDE ? 'Tage' : 'days'}
                </dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
    )}

    <div class="mt-16 rounded-xl bg-ink-50 p-6 dark:bg-ink-800/50">
      <h2 class="text-xl font-bold">{isDE ? 'Möchten Sie die nächste sein?' : 'Want to be next?'}</h2>
      <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
        {isDE
          ? 'Wir starten mit einem kostenlosen Scan und einem 48-Stunden-Angebot. Keine Verpflichtung.'
          : 'We start with a free scan and a 48-hour quote. No commitment.'}
      </p>
      <a href={routePath('remediation', locale)} class="mt-4 inline-block rounded-md bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
        {isDE ? 'Angebot anfordern' : 'Request a quote'}
      </a>
    </div>
  </div>
</section>
