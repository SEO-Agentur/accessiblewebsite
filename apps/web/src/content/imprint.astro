---
import type { Locale } from '@accessiblewebsite/shared';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';
---

<section class="px-4 py-16">
  <article class="mx-auto max-w-2xl">
    <h1 class="text-4xl font-bold tracking-tight">
      {isDE ? 'Impressum' : 'Imprint'}
    </h1>
    <p class="mt-2 text-sm text-ink-400">
      {isDE
        ? 'Angaben gemäß § 5 TMG'
        : 'Disclosure per § 5 of the German Telemedia Act (TMG)'}
    </p>

    <div class="mt-8 space-y-6 text-sm text-ink-600 dark:text-ink-200">
      <div>
        <h2 class="font-semibold text-ink-900 dark:text-ink-50">{isDE ? 'Betreiber' : 'Operator'}</h2>
        <p class="mt-1">
          SEO Agentur GmbH<br />
          Beispielstraße 1<br />
          12345 Berlin<br />
          {isDE ? 'Deutschland' : 'Germany'}
        </p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900 dark:text-ink-50">{isDE ? 'Vertreten durch' : 'Represented by'}</h2>
        <p class="mt-1">Cyrus Badde, {isDE ? 'Geschäftsführer' : 'Managing Director'}</p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900 dark:text-ink-50">{isDE ? 'Kontakt' : 'Contact'}</h2>
        <p class="mt-1">
          {isDE ? 'E-Mail: ' : 'Email: '}
          <a class="underline" href={`mailto:${isDE ? 'team@barrierefreiewebseite.net' : 'team@accessiblewebsite.net'}`}>
            {isDE ? 'team@barrierefreiewebseite.net' : 'team@accessiblewebsite.net'}
          </a>
        </p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900 dark:text-ink-50">{isDE ? 'Registereintrag' : 'Register entry'}</h2>
        <p class="mt-1">
          {isDE ? 'Eintragung im Handelsregister' : 'Commercial register entry'}<br />
          {isDE ? 'Registergericht: Amtsgericht Berlin' : 'Registering court: Amtsgericht Berlin'}<br />
          {isDE ? 'Registernummer: HRB 000000' : 'Register number: HRB 000000'}
        </p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900 dark:text-ink-50">{isDE ? 'Umsatzsteuer-ID' : 'VAT ID'}</h2>
        <p class="mt-1">
          {isDE
            ? 'Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG:'
            : 'VAT identification number per § 27a German VAT Act:'}{' '}
          DE000000000
        </p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900 dark:text-ink-50">
          {isDE ? 'Verantwortlich für den Inhalt (§ 18 Abs. 2 MStV)' : 'Responsible for content per § 18(2) MStV'}
        </h2>
        <p class="mt-1">Cyrus Badde, {isDE ? 'Anschrift wie oben' : 'address as above'}</p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900 dark:text-ink-50">{isDE ? 'EU-Streitschlichtung' : 'EU dispute resolution'}</h2>
        <p class="mt-1">
          {isDE
            ? 'Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung bereit: '
            : 'The European Commission provides an online dispute resolution platform: '}
          <a class="underline" rel="noopener" href="https://ec.europa.eu/consumers/odr/">https://ec.europa.eu/consumers/odr/</a>.
          {isDE
            ? ' Wir sind nicht verpflichtet und nicht bereit, an einem Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.'
            : ' We are not obliged and not willing to participate in dispute resolution proceedings before a consumer arbitration board.'}
        </p>
      </div>

      <p class="rounded-md bg-amber-50 p-3 text-xs text-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
        {isDE
          ? 'Hinweis: Die hier gezeigten Angaben sind Platzhalter. Vor der Live-Schaltung müssen die rechtlich verbindlichen Firmendaten eingetragen werden.'
          : 'Note: the details shown here are placeholders. Before going public, the legally binding company data must be entered.'}
      </p>
    </div>
  </article>
</section>
