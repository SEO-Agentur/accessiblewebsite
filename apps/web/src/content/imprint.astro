---
import type { Locale } from '@accessiblewebsite/shared';
import { env } from '../env';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';

const cfg = env();
// § 5 TMG only requires Name, Address, fast direct contact (email or phone).
// "Geschäftsführer" (managing director) and registry entries only apply to
// GmbHs/UGs/AGs — for a natural-person operator they are not required.
const hasOperatorData = Boolean(
  cfg.COMPANY_NAME &&
    cfg.COMPANY_ADDRESS_LINE_1 &&
    cfg.COMPANY_POSTAL_CITY &&
    cfg.COMPANY_CONTACT_EMAIL,
);
const responsibleParty = cfg.COMPANY_MANAGING_DIRECTOR ?? cfg.COMPANY_NAME ?? '';
---

<section class="px-4 py-16">
  <article class="mx-auto max-w-2xl">
    <h1 class="text-4xl font-bold tracking-tight">
      {isDE ? 'Impressum' : 'Imprint'}
    </h1>
    <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">
      {isDE ? 'Angaben gemäß § 5 TMG' : 'Disclosure per § 5 of the German Telemedia Act (TMG)'}
    </p>

    {!hasOperatorData ? (
      <div
        role="alert"
        class="mt-8 rounded-xl border-2 border-amber-300 bg-amber-50 p-6 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-900/20 dark:text-amber-100"
      >
        <h2 class="text-base font-bold">
          {isDE ? 'Imprint-Daten nicht konfiguriert' : 'Imprint data not configured'}
        </h2>
        <p class="mt-2">
          {isDE
            ? 'Diese Seite zeigt erst dann verbindliche Angaben, wenn der Betreiber die COMPANY_*-Variablen in der .env-Datei gesetzt hat. Vor der Live-Schaltung in der EU ist das ein Pflichtfeld nach § 5 TMG.'
            : "This page only shows binding details once the operator has set the COMPANY_* variables in the .env file. Before going public in the EU, this is a § 5 TMG legal requirement."}
        </p>
        <p class="mt-3 font-mono text-xs">
          COMPANY_NAME, COMPANY_ADDRESS_LINE_1, COMPANY_POSTAL_CITY,<br />
          COMPANY_MANAGING_DIRECTOR, COMPANY_CONTACT_EMAIL,<br />
          COMPANY_REGISTRY_COURT, COMPANY_REGISTRY_NUMBER, COMPANY_VAT_ID
        </p>
      </div>
    ) : (
      <div class="mt-8 space-y-6 text-sm text-ink-600 dark:text-ink-200">
        <div>
          <h2 class="font-semibold text-ink-900 dark:text-ink-50">
            {isDE ? 'Betreiber' : 'Operator'}
          </h2>
          <p class="mt-1">
            {cfg.COMPANY_NAME}<br />
            {cfg.COMPANY_ADDRESS_LINE_1}<br />
            {cfg.COMPANY_ADDRESS_LINE_2 && (<>{cfg.COMPANY_ADDRESS_LINE_2}<br /></>)}
            {cfg.COMPANY_POSTAL_CITY}<br />
            {cfg.COMPANY_COUNTRY ?? (isDE ? 'Deutschland' : 'Germany')}
          </p>
        </div>

        {cfg.COMPANY_MANAGING_DIRECTOR && (
          <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-50">
              {isDE ? 'Vertreten durch' : 'Represented by'}
            </h2>
            <p class="mt-1">
              {cfg.COMPANY_MANAGING_DIRECTOR}, {isDE ? 'Geschäftsführer' : 'Managing Director'}
            </p>
          </div>
        )}

        <div>
          <h2 class="font-semibold text-ink-900 dark:text-ink-50">
            {isDE ? 'Kontakt' : 'Contact'}
          </h2>
          {/*
            Cloudflare's "Email Address Obfuscation" rewrites mailto: links
            to a [email protected] placeholder decoded by JS. § 5 TMG
            ("schnelle elektronische Kontaktaufnahme") requires the address
            to be plainly readable — including without JS for screen-reader
            users. Wrap the email in <!--email_off-->...<!--/email_off-->
            to opt this specific element out of obfuscation site-wide
            while keeping CF's scrape-shield active everywhere else.
          */}
          <p class="mt-1">
            {isDE ? 'E-Mail: ' : 'Email: '}
            <Fragment set:html={`<!--email_off--><a class="underline" href="mailto:${cfg.COMPANY_CONTACT_EMAIL}">${cfg.COMPANY_CONTACT_EMAIL}</a><!--/email_off-->`} />
          </p>
        </div>

        {(cfg.COMPANY_REGISTRY_COURT || cfg.COMPANY_REGISTRY_NUMBER) && (
          <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-50">
              {isDE ? 'Registereintrag' : 'Register entry'}
            </h2>
            <p class="mt-1">
              {cfg.COMPANY_REGISTRY_COURT && (
                <>{isDE ? 'Registergericht: ' : 'Registering court: '}{cfg.COMPANY_REGISTRY_COURT}<br /></>
              )}
              {cfg.COMPANY_REGISTRY_NUMBER && (
                <>{isDE ? 'Registernummer: ' : 'Register number: '}{cfg.COMPANY_REGISTRY_NUMBER}</>
              )}
            </p>
          </div>
        )}

        {cfg.COMPANY_VAT_ID && (
          <div>
            <h2 class="font-semibold text-ink-900 dark:text-ink-50">
              {isDE ? 'Umsatzsteuer-ID' : 'VAT ID'}
            </h2>
            <p class="mt-1">
              {isDE
                ? 'Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: '
                : 'VAT identification number per § 27a German VAT Act: '}
              {cfg.COMPANY_VAT_ID}
            </p>
          </div>
        )}

        <div>
          <h2 class="font-semibold text-ink-900 dark:text-ink-50">
            {isDE
              ? 'Verantwortlich für den Inhalt (§ 18 Abs. 2 MStV)'
              : 'Responsible for content per § 18(2) MStV'}
          </h2>
          <p class="mt-1">{responsibleParty}, {isDE ? 'Anschrift wie oben' : 'address as above'}</p>
        </div>

        <div>
          <h2 class="font-semibold text-ink-900 dark:text-ink-50">
            {isDE ? 'Haftungsausschluss' : 'Disclaimer'}
          </h2>
          <p class="mt-1">
            {isDE
              ? 'Für die Inhalte externer Links übernimmt der Betreiber keine Haftung; für den Inhalt verlinkter Seiten sind ausschließlich deren Betreiber verantwortlich.'
              : 'The operator assumes no liability for external link content; only the operators of those linked pages are responsible for their content.'}
          </p>
        </div>

        <div>
          <h2 class="font-semibold text-ink-900 dark:text-ink-50">
            {isDE ? 'EU-Streitschlichtung' : 'EU dispute resolution'}
          </h2>
          <p class="mt-1">
            {isDE
              ? 'Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung bereit: '
              : 'The European Commission provides an online dispute resolution platform: '}
            <a class="underline" rel="noopener" href="https://ec.europa.eu/consumers/odr/">https://ec.europa.eu/consumers/odr/</a>.
            {isDE
              ? ' Wir sind nicht verpflichtet und nicht bereit, an einem Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.'
              : ' We are not obliged and not willing to participate in dispute resolution proceedings before a consumer arbitration board.'}
          </p>
        </div>
      </div>
    )}
  </article>
</section>
