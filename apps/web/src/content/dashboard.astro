---
import type { Locale } from '@accessiblewebsite/shared';
import { desc, eq } from 'drizzle-orm';
import { monitoredSites, scans, subscriptions } from '@accessiblewebsite/db';
import { db } from '../lib/db';
import { routePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';

// Auth gate is enforced by the catch-all router. This component is only
// reached when there's a real session.
const user = Astro.locals.user!;

const sites = await db()
  .select()
  .from(monitoredSites)
  .where(eq(monitoredSites.userId, user.id))
  .orderBy(desc(monitoredSites.createdAt));

const recentScans = await db()
  .select()
  .from(scans)
  .where(eq(scans.triggeredBy, 'user'))
  .orderBy(desc(scans.createdAt))
  .limit(10);

const [activeSub] = await db()
  .select()
  .from(subscriptions)
  .where(eq(subscriptions.userId, user.id))
  .orderBy(desc(subscriptions.createdAt))
  .limit(1);

const tier = activeSub?.tier ?? 'free';
const tierLabel = { free: 'Free', gold: 'Gold', gold_pro: 'Gold Pro', enterprise: 'Enterprise' }[tier];

const fmtDate = (d: Date | null): string =>
  d ? d.toLocaleString(isDE ? 'de-DE' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '—';

const added = Astro.url.searchParams.get('added') === '1';
const errorCode = Astro.url.searchParams.get('error');
---

<section class="px-4 py-12">
  <div class="mx-auto max-w-5xl">
    <header class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-sm text-ink-400">{isDE ? 'Angemeldet als' : 'Signed in as'} {user.email}</p>
        <h1 class="text-3xl font-bold tracking-tight">
          {isDE ? `Willkommen, ${user.fullName ?? user.email}` : `Welcome, ${user.fullName ?? user.email}`}
        </h1>
      </div>
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold dark:bg-ink-700">
          {tierLabel}
        </span>
        <form method="POST" action="/api/v1/auth/logout">
          <button type="submit" class="rounded-md border border-ink-200 px-3 py-1.5 text-sm font-semibold hover:bg-ink-50 dark:border-ink-600 dark:hover:bg-ink-800">
            {isDE ? 'Abmelden' : 'Log out'}
          </button>
        </form>
      </div>
    </header>

    {added && (
      <p class="mt-6 rounded-md bg-emerald-50 px-4 py-2 text-sm text-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">
        {isDE ? 'Webseite hinzugefügt.' : 'Site added.'}
      </p>
    )}
    {errorCode === 'invalid_domain' && (
      <p class="mt-6 rounded-md bg-red-50 px-4 py-2 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200" role="alert">
        {isDE ? 'Ungültige Domain.' : 'Invalid domain.'}
      </p>
    )}
    {errorCode === 'duplicate' && (
      <p class="mt-6 rounded-md bg-amber-50 px-4 py-2 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200" role="alert">
        {isDE ? 'Diese Domain ist bereits in Ihrer Liste.' : 'You already monitor this domain.'}
      </p>
    )}

    <section class="mt-10">
      <h2 class="text-xl font-bold">{isDE ? 'Überwachte Webseiten' : 'Monitored sites'}</h2>

      {sites.length === 0 ? (
        <p class="mt-4 text-sm text-ink-600 dark:text-ink-200">
          {isDE
            ? 'Sie überwachen noch keine Webseiten. Fügen Sie unten Ihre erste hinzu.'
            : 'You don’t monitor any sites yet. Add your first below.'}
        </p>
      ) : (
        <ul class="mt-4 grid gap-3">
          {sites.map((site) => (
            <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white p-4 dark:border-ink-600 dark:bg-ink-800">
              <div>
                <p class="font-semibold">{site.domain}</p>
                <p class="text-xs text-ink-400">
                  {isDE ? 'Letzter Scan: ' : 'Last scan: '}{fmtDate(site.lastScanAt)}
                  {site.currentScore !== null && (
                    <span class="ml-2 font-semibold text-ink-700 dark:text-ink-200">
                      · {site.currentScore}/100
                    </span>
                  )}
                </p>
              </div>
              <form method="POST" action={`/api/v1/sites/${site.id}/rescan`}>
                <button type="submit" class="rounded-md bg-brand-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-800">
                  {isDE ? 'Jetzt scannen' : 'Scan now'}
                </button>
              </form>
            </li>
          ))}
        </ul>
      )}

      <form
        method="POST"
        action="/api/v1/sites"
        class="mt-6 rounded-xl border border-dashed border-ink-200 p-4 dark:border-ink-600"
      >
        <label for="new-site-domain" class="block text-sm font-medium">
          {isDE ? 'Neue Domain hinzufügen' : 'Add a new domain'}
        </label>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
          <input
            id="new-site-domain"
            name="domain"
            type="text"
            required
            placeholder="example.com"
            class="flex-1 rounded-md border border-ink-200 bg-white px-3 py-2 dark:border-ink-600 dark:bg-ink-900"
          />
          <button type="submit" class="rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800">
            {isDE ? 'Hinzufügen' : 'Add site'}
          </button>
        </div>
        <p class="mt-2 text-xs text-ink-400">
          {isDE
            ? 'Nur die Domain (z. B. ihre-firma.de), ohne https:// oder Pfad.'
            : 'Just the domain (e.g. yourcompany.com), no https:// or path.'}
        </p>
      </form>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold">{isDE ? 'Letzte Scans' : 'Recent scans'}</h2>

      {recentScans.length === 0 ? (
        <p class="mt-4 text-sm text-ink-600 dark:text-ink-200">
          {isDE ? 'Noch keine Scans.' : 'No scans yet.'}
        </p>
      ) : (
        <ul class="mt-4 grid gap-2">
          {recentScans.map((scan) => (
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-ink-200 bg-white p-3 text-sm dark:border-ink-600 dark:bg-ink-800">
              <div>
                <a href={`/scan/${scan.id}`} class="font-semibold underline hover:text-brand-700 dark:hover:text-brand-200">
                  {(() => { try { return new URL(scan.targetUrl).host; } catch { return scan.targetUrl; } })()}
                </a>
                <span class="ml-2 text-xs text-ink-400">{fmtDate(scan.createdAt)}</span>
              </div>
              <div class="flex items-center gap-2 text-xs">
                {scan.score !== null && <span class="font-semibold">{scan.score}/100</span>}
                <span class="rounded-full bg-ink-100 px-2 py-0.5 dark:bg-ink-700">{scan.status}</span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</section>
