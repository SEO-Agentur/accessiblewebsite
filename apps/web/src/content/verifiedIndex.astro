---
import type { Locale } from '@accessiblewebsite/shared';
import { and, desc, eq, gte, inArray, or, sql } from 'drizzle-orm';
import { monitoredSites, subscriptions, users, scans } from '@accessiblewebsite/db';
import { db } from '../lib/db';
import { getOwnerEmailList } from '../lib/owner';
import { MIN_DIRECTORY_SCORE, tierFromScore } from '../lib/seal';
import { routePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDE = locale === 'de';

// 1 hour shared cache on the directory itself — content turns over slowly
// (new Gold members + monthly embed-check recalculations), so an hour of
// staleness is fine and protects the DB from crawler bursts.
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=3600');

// Listings: a public, opted-in monitored site whose owner is either an
// active Gold/Gold-Pro subscriber or in OWNER_EMAILS, and whose latest
// scan is at or above the Bronze threshold (70). Anything weaker doesn't
// belong on a "Verified websites" page no matter who paid.
type DirectoryRank = 'gold' | 'silver' | 'bronze';
type DirectoryBadge = 'gold_pro' | 'gold' | 'owner';
type DirectoryRow = {
  domain: string;
  score: number;
  rank: DirectoryRank;
  badge: DirectoryBadge;
  country: string | null;
  company: string | null;
  latestScanId: string | null;
  lastScanAt: Date | null;
};

const ownerEmails = getOwnerEmailList();

const rows = await db()
  .select({
    domain: monitoredSites.domain,
    score: monitoredSites.currentScore,
    lastScanAt: monitoredSites.lastScanAt,
    subscriptionTier: subscriptions.tier,
    subscriptionStatus: subscriptions.status,
    email: users.email,
    country: users.countryCode,
    company: users.companyName,
    latestScanId: sql<string | null>`(
      SELECT s.id
      FROM ${scans} s
      WHERE s.monitored_site_id = ${monitoredSites.id}
        AND s.status = 'completed'
      ORDER BY s.created_at DESC
      LIMIT 1
    )`,
  })
  .from(monitoredSites)
  .innerJoin(users, eq(users.id, monitoredSites.userId))
  .leftJoin(subscriptions, eq(subscriptions.userId, monitoredSites.userId))
  .where(
    and(
      eq(monitoredSites.isPublicInDirectory, true),
      gte(monitoredSites.currentScore, MIN_DIRECTORY_SCORE),
      or(
        and(
          inArray(subscriptions.tier, ['gold', 'gold_pro']),
          inArray(subscriptions.status, ['active', 'trialing']),
        ),
        ownerEmails.length > 0 ? inArray(users.email, ownerEmails) : sql`false`,
      ),
    ),
  );

const badgeRank = (b: DirectoryBadge): number =>
  b === 'owner' ? 3 : b === 'gold_pro' ? 2 : 1;

// Same user × multiple subscriptions × multiple monitored_sites can produce
// duplicate rows from the join. Dedupe on domain, preferring the strongest
// badge (owner > gold_pro > gold) so a Pro+owner doesn't appear as Gold.
const dedup = new Map<string, DirectoryRow>();
for (const r of rows) {
  if (r.score === null) continue;
  const rank = tierFromScore(r.score);
  if (!rank) continue;
  const isOwner = ownerEmails.includes((r.email ?? '').toLowerCase());
  const badge: DirectoryBadge = isOwner
    ? 'owner'
    : r.subscriptionTier === 'gold_pro'
      ? 'gold_pro'
      : 'gold';
  const existing = dedup.get(r.domain);
  if (existing && badgeRank(existing.badge) >= badgeRank(badge)) continue;
  dedup.set(r.domain, {
    domain: r.domain,
    score: r.score,
    rank,
    badge,
    country: r.country,
    company: r.company,
    latestScanId: r.latestScanId,
    lastScanAt: r.lastScanAt,
  });
}

// Composite sort: rank class first (gold > silver > bronze), then exact
// score, then scan recency. Treats all golds as a single tier rather than
// rewarding 99/100 over 95/100 — both passed the same threshold.
const rankWeight = (r: DirectoryRank): number =>
  r === 'gold' ? 3 : r === 'silver' ? 2 : 1;

const sites: DirectoryRow[] = [...dedup.values()].sort((a, b) => {
  const dr = rankWeight(b.rank) - rankWeight(a.rank);
  if (dr !== 0) return dr;
  if (b.score !== a.score) return b.score - a.score;
  const ta = a.lastScanAt?.getTime() ?? 0;
  const tb = b.lastScanAt?.getTime() ?? 0;
  return tb - ta;
});

// "Recently scanned" widget — last 10 completed scans, irrespective of
// owner / subscription. Every /scan/{id} URL is already crawlable; surfacing
// the 10 freshest gives search engines a steady feed of new links and acts
// as a low-key signal that the scanner is alive and humming.
const recent = await db()
  .select({
    id: scans.id,
    targetUrl: scans.targetUrl,
    score: scans.score,
    completedAt: scans.completedAt,
  })
  .from(scans)
  .where(eq(scans.status, 'completed'))
  .orderBy(desc(scans.completedAt))
  .limit(10);

const recentList = recent.map((r) => {
  let host = r.targetUrl;
  try {
    host = new URL(r.targetUrl).host.replace(/^www\./, '');
  } catch {
    /* keep raw */
  }
  return { id: r.id, host, score: r.score, completedAt: r.completedAt };
});

const rankLabel = (r: DirectoryRank): string =>
  r === 'gold' ? 'Gold' : r === 'silver' ? (isDE ? 'Silber' : 'Silver') : 'Bronze';

const badgeLabel = (b: DirectoryBadge): string =>
  b === 'owner'
    ? (isDE ? 'Betreiber' : 'Operator')
    : b === 'gold_pro'
      ? 'Gold Pro'
      : 'Gold';

const rankClasses = (r: DirectoryRank): string =>
  r === 'gold'
    ? 'text-amber-700 dark:text-amber-300'
    : r === 'silver'
      ? 'text-ink-600 dark:text-ink-200'
      : 'text-orange-700 dark:text-orange-300';

const fmtScanDate = (d: Date | null): string => {
  if (!d) return '';
  return d.toLocaleString(isDE ? 'de-DE' : 'en-GB', {
    dateStyle: 'medium',
    timeStyle: 'short',
  });
};
---

<section class="px-4 py-16">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-4xl font-bold tracking-tight">
      {isDE ? 'Verifizierte Webseiten' : 'Verified websites'}
    </h1>
    <p class="mt-4 text-lg text-ink-600 dark:text-ink-200">
      {isDE
        ? 'Webseiten, die unabhängig auf WCAG 2.2 AA Konformität geprüft wurden. Jede Listung verlinkt auf den vollständigen Bericht, den letzten Scan, und die Verlaufsgeschichte.'
        : 'Websites independently verified for WCAG 2.2 AA conformance. Every listing links to the full report, the latest scan, and the history.'}
    </p>

    {sites.length === 0 ? (
      <div class="mt-12 rounded-xl border-2 border-dashed border-ink-200 p-12 text-center dark:border-ink-600">
        <p class="text-lg font-semibold">
          {isDE ? 'Noch keine öffentlichen Listungen' : 'No public listings yet'}
        </p>
        <p class="mt-2 text-sm text-ink-600 dark:text-ink-200">
          {isDE
            ? 'Sobald die ersten Webseiten ihre Prüfung bestehen und der öffentlichen Listung zustimmen, erscheinen sie hier. Möchten Sie die erste sein?'
            : 'As soon as the first sites pass their scan and opt into the public directory, they will appear here. Want to be first?'}
        </p>
        <a href={routePath('home', locale)} class="mt-6 inline-block rounded-md bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
          {isDE ? 'Webseite jetzt prüfen' : 'Scan your site now'}
        </a>
      </div>
    ) : (
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {sites.map((site) => {
          const href = site.latestScanId
            ? `/scan/${site.latestScanId}`
            : `${routePath('verifiedIndex', locale)}/${site.domain}`;
          return (
            <li class="rounded-xl border border-ink-200 bg-white p-4 dark:border-ink-600 dark:bg-ink-800">
              <a href={href} class="block">
                <p class="font-semibold">{site.domain}</p>
                <p class="text-sm text-ink-500 dark:text-ink-400">
                  {site.company ?? (isDE ? 'Eigentümer auf Wunsch' : 'Owner on request')}
                  {site.country && (
                    <>
                      {' · '}
                      {site.country}
                    </>
                  )}
                </p>
                <p class={`mt-2 text-2xl font-bold ${rankClasses(site.rank)}`}>{site.score}/100</p>
                <p class="mt-1 flex flex-wrap items-center gap-1.5 text-xs uppercase tracking-wide">
                  <span class={`font-bold ${rankClasses(site.rank)}`}>{rankLabel(site.rank)}</span>
                  <span class="rounded-full bg-ink-100 px-2 py-0.5 text-[10px] font-semibold normal-case tracking-normal text-ink-700 dark:bg-ink-700 dark:text-ink-100">
                    {badgeLabel(site.badge)}
                  </span>
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    {recentList.length > 0 && (
      <section class="mt-16">
        <h2 class="text-xl font-bold">
          {isDE ? 'Zuletzt geprüfte URLs' : 'Recently scanned URLs'}
        </h2>
        <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">
          {isDE
            ? 'Die letzten 10 abgeschlossenen Prüfungen — jeder Eintrag verlinkt auf den vollständigen Bericht. Wird stündlich aktualisiert.'
            : 'The last 10 completed scans — each entry links to the full report. Refreshed hourly.'}
        </p>
        <ul class="mt-4 divide-y divide-ink-200 rounded-xl border border-ink-200 bg-white text-sm dark:divide-ink-700 dark:border-ink-600 dark:bg-ink-800">
          {recentList.map((r) => (
            <li>
              <a
                href={`/scan/${r.id}`}
                class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 hover:bg-ink-50 dark:hover:bg-ink-700"
              >
                <span class="break-all font-medium">{r.host}</span>
                <span class="flex items-center gap-3 text-xs text-ink-500 dark:text-ink-400">
                  {typeof r.score === 'number' && (
                    <span class="font-semibold tabular-nums text-ink-700 dark:text-ink-100">
                      {r.score}/100
                    </span>
                  )}
                  <time datetime={r.completedAt?.toISOString() ?? ''}>{fmtScanDate(r.completedAt)}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-16 rounded-xl bg-ink-50 p-6 dark:bg-ink-800/50">
      <h2 class="text-xl font-bold">{isDE ? 'Wie das Siegel funktioniert' : 'How the seal works'}</h2>
      <ol class="mt-4 space-y-3 text-sm text-ink-600 dark:text-ink-200">
        <li>1. {isDE ? 'Sie führen einen kostenlosen Scan durch.' : 'You run a free scan.'}</li>
        <li>2. {isDE ? 'Bronze ab 70, Silber ab 80, Gold ab 95 — alle 90 Tage gültig.' : 'Bronze from 70, Silver from 80, Gold from 95 — each valid 90 days.'}</li>
        <li>3. {isDE ? 'Mit einem Gold-Abo wird das Siegel live: monatliche Scans, automatische Status-Updates, Alarme bei Regressionen.' : 'With a Gold subscription the seal goes live: monthly scans, automatic status updates, alerts on regression.'}</li>
        <li>4. {isDE ? 'Klicks auf das Siegel landen auf Ihrer öffentlichen Verifizierungs-Seite. Vertrauenssignal, das Sie selbst nicht fälschen können.' : 'Clicks on the seal land on your public verification page. A trust signal you cannot fake yourself.'}</li>
      </ol>
    </div>
  </div>
</section>
