{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.d.ts",
    "**/*.ts",
    "**/*.astro",
    "**/*.tsx"
  ],
  "exclude": ["dist", "node_modules"]
}
